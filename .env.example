# Copy this file to .env and fill in your own values.
# Never commit the real .env, it's already in .gitignore.

# Switch SSH credentials (used by Netmiko for CSW1/CSW2)
NETLAB_USERNAME=
NETLAB_PASSWORD=

# PA-440 firewall API credentials
PA_HOST=
PA_USERNAME=
PA_PASSWORD=

# Alert email (Gmail SMTP) used by diff_config.py
# ALERT_EMAIL_PASSWORD is a 16-character Gmail "app password", not your normal password
ALERT_EMAIL=
ALERT_EMAIL_PASSWORD=
